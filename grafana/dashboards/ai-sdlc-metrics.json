          "expr": "sum by (skill) (last_over_time({job=\"ai-sdlc-metrics\", metric=\"Skill invocations\"} | json | value=~\".+\" | regexp \"skill: (?P<skill>[^;]+)\" | skill!=\"\" | unwrap value [$window]) by (skill, pr_number, notes))",
          "queryType": "range",

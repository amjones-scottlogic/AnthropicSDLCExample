      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "title": "Every row for the chosen PR (empty values shown, with notes)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ai-sdlc-metrics\"} | json | pr_number=~\"$pr\"",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "description": "Raw rows, grouped by stage. An empty value means nothing was captured; the notes say why.",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "id": true,
              "tsNs": true,
              "stage_extracted": true,
              "Time": true,
              "kind_extracted": true,
              "metric_extracted": true,
              "job": true
            },
            "indexByName": {
              "stage": 0,
              "metric": 1,
              "pr_number": 2,
              "captured_at": 3,
              "value": 4,
              "unit": 5,
              "notes": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "stage"
              },
              {
                "field": "captured_at",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Skill usage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "title": "About these numbers",
      "type": "text",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 66,
        "w": 24,
        "h": 3
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "Only **repository skills** are counted. Counts are **by branch** and only from contributors who ran the capture, so they are **approximate**. A contributor with no captured session shows as missing, not as zero. Contributors' rows for one PR are added together."
      }
    },
    {
      "id": 17,
      "title": "Skill invocations for the chosen PR",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 69,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (skill) (last_over_time({job=\"ai-sdlc-metrics\", metric=\"Skill invocations\"} | json | value=~\".+\" | regexp \"skill: (?P<skill>[^;]+)\" | skill!=\"\" | pr_number=~\"$pr\" | unwrap value [1825d]) by (skill, pr_number, notes))",
          "queryType": "instant",
          "legendFormat": "{{skill}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false

{
  "uid": "ai-sdlc-metrics",
  "title": "AI-SDLC metrics",
  "tags": [
    "ai-sdlc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metric",
        "label": "Metric",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "metric",
          "stream": "{job=\"ai-sdlc-metrics\"}",
          "type": 1
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "stage",
        "label": "Stage",
        "type": "custom",
        "query": "Plan,Design,Build,n/a",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "kind",
        "label": "Kind",
        "type": "custom",
        "query": "leading,lagging",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "pr",
        "label": "PR number (.+ for all)",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "options": [
          {
            "text": ".+",
            "value": ".+",
            "selected": true
          }
        ]
      },
      {
        "name": "window",
        "label": "Snapshots",
        "type": "custom",
        "query": "Latest per PR : 1825d,All snapshots : 1d",
        "current": {
          "text": "Latest per PR",
          "value": "1825d"
        },
        "options": []
      },
      {
        "name": "sdlc_stage",
        "label": "Stages (SDLC items)",
        "type": "custom",
        "multi": true,
        "includeAll": false,
        "query": "awaiting-spec,awaiting-plan,in-build,built",
        "current": {
          "text": [
            "awaiting-spec",
            "awaiting-plan",
            "in-build"
          ],
          "value": [
            "awaiting-spec",
            "awaiting-plan",
            "in-build"
          ]
        },
        "options": [
          {
            "text": "awaiting-spec",
            "value": "awaiting-spec",
            "selected": true
          },
          {
            "text": "awaiting-plan",
            "value": "awaiting-plan",
            "selected": true
          },
          {
            "text": "in-build",
            "value": "in-build",
            "selected": true
          },
          {
            "text": "built",
            "value": "built",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Last collector run",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ai-sdlc-metrics-runs\"}",
          "queryType": "range",
          "legendFormat": "",
          "maxLines": 1
        }
      ],
      "description": "The most recent run of the collector. Nothing is scheduled: run npm run metrics:collect (with npm run metrics:up) to refresh the data.",
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 23,
      "type": "row",
      "title": "SDLC progress",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 24,
      "title": "SDLC stages last loaded",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "timeFrom": "1y",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ai-sdlc-stages\"}",
          "queryType": "range",
          "legendFormat": "",
          "maxLines": 1
        }
      ],
      "description": "The newest SDLC stages snapshot: its time, and main_commit, the origin/main commit it was read from. Nothing is scheduled: run npm run metrics:collect (with npm run metrics:up) to refresh.",
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 25,
      "title": "SDLC items (latest snapshot)",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 10
      },
      "timeFrom": "1y",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ai-sdlc-stages\", stage=~\"$sdlc_stage\"}",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "description": "One row per intent, spec and plan number, from the newest snapshot. Stage is worked out from what is merged to origin/main. Use the Stages selector to include built items.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "stage"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "awaiting-spec": {
                        "text": "awaiting spec",
                        "color": "red",
                        "index": 0
                      },
                      "awaiting-plan": {
                        "text": "awaiting plan",
                        "color": "yellow",
                        "index": 1
                      },
                      "in-build": {
                        "text": "in build",
                        "color": "blue",
                        "index": 2
                      },
                      "built": {
                        "text": "built",
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "in stage since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "number": {
                "operation": "groupby"
              },
              "slug": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "stage": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "stage_since": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "intent_status": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "spec_status": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              },
              "plan_status": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              }
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "stage_since (first)",
                "destinationType": "time"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "number": 0,
              "slug (first)": 1,
              "stage (first)": 2,
              "stage_since (first)": 3,
              "intent_status (first)": 4,
              "spec_status (first)": 5,
              "plan_status (first)": 6
            },
            "renameByName": {
              "slug (first)": "slug",
              "stage (first)": "stage",
              "stage_since (first)": "in stage since",
              "intent_status (first)": "intent",
              "spec_status (first)": "spec",
              "plan_status (first)": "plan"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "number"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 26,
      "title": "SDLC items per stage (latest snapshot)",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 10
      },
      "timeFrom": "1y",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ai-sdlc-stages\"}",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "description": "How many items sit in each stage in the newest snapshot, built items included.",
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        }
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "number": {
                "operation": "groupby"
              },
              "stage": {
                "operation": "aggregate",
                "aggregations": [
                  "first"
                ]
              }
            }
          }
        },
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "stage (first)": {
                "operation": "groupby"
              },
              "number": {
                "operation": "aggregate",
                "aggregations": [
                  "count"
                ]
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "stage (first)": "stage",
              "number (count)": "items"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "row",
      "title": "Each metric over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Selected metrics over time (average across PRs)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "avg by (metric) (last_over_time({job=\"ai-sdlc-metrics\", metric=~\"$metric\", metric!~\"Tokens|Skill invocations\", kind=~\"$kind\", stage=~\".*$stage.*\"} | json | value=~\".+\" | unwrap value [$window]) by (metric, pr_number, change, notes))",
          "queryType": "range",
          "legendFormat": "{{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,

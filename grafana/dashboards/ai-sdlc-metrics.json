{
  "uid": "ai-sdlc-metrics",
  "title": "AI-SDLC metrics",
  "tags": [
    "ai-sdlc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metric",
        "label": "Metric",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "metric",
          "stream": "{job=\"ai-sdlc-metrics\"}",
          "type": 1
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "stage",
        "label": "Stage",
        "type": "custom",
        "query": "Plan,Design,Build,n/a",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "kind",
        "label": "Kind",
        "type": "custom",
        "query": "leading,lagging",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "pr",
        "label": "PR number (.+ for all)",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "options": [
          {
            "text": ".+",
            "value": ".+",
            "selected": true
          }
        ]
      },
      {
        "name": "window",
        "label": "Snapshots",
        "type": "custom",
        "query": "Latest per PR : 1825d,All snapshots : 1d",
        "current": {
          "text": "Latest per PR",
          "value": "1825d"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Last collector run",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ai-sdlc-metrics-runs\"}",
          "queryType": "range",
          "legendFormat": "",
          "maxLines": 1
        }
      ],
      "description": "The most recent run of the collector. Nothing is scheduled: run npm run metrics:collect (with npm run metrics:up) to refresh the data.",
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Each metric over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Selected metrics over time (average across PRs)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "avg by (metric) (last_over_time({job=\"ai-sdlc-metrics\", metric=~\"$metric\", metric!~\"Tokens|Skill invocations\", kind=~\"$kind\", stage=~\".*$stage.*\"} | json | value=~\".+\" | unwrap value [$window]) by (metric, pr_number, change, notes))",
          "queryType": "range",
          "legendFormat": "{{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Plan: leading and lagging",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },

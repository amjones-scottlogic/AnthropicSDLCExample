            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Token usage",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 63,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "title": "About these numbers",
      "type": "text",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 3
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "Token **counts** only; no cost is recorded. Counts are **by branch** and only from contributors who ran the capture, so they are **approximate**. Contributors' rows for one PR are added together per model and token type."
      }
    },
    {
      "id": 21,
      "title": "Tokens for the chosen PR (by model and type)",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 67,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (series) (last_over_time({job=\"ai-sdlc-metrics\", metric=\"Tokens\"} | json | value=~\".+\" | regexp \"^[^;]*; (?P<model>[^;]+); (?P<type>input|output|cache read|cache write);\" | label_format series=\"{{.model}} {{.type}}\" | pr_number=~\"$pr\" | unwrap value [1825d]) by (series, pr_number, notes))",
          "queryType": "instant",
          "legendFormat": "{{series}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        },
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
